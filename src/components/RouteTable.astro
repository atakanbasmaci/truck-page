---
// Güzergah listesi: il etiketleri.
import { routesByKm, routePath } from '../lib/site';
---

<ul class="chips" aria-label="İzmir çıkışlı ve varışlı güzergahlar">
  {
    routesByKm.map((r) => (
      <li>
        <a class="chip" href={routePath(r)} title={r.region}>İzmir – {r.city}</a>
      </li>
    ))
  }
</ul>
