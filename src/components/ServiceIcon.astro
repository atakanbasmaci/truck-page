---
// Hizmet ikonları: tek renk, ince çizgi. Sıcaklığı simgeler.
//   donuk (−18°C): buz kristali · soğuk (+2/+8°C): damla · kuru gıda: buğday · parsiyel/komple: paletli koli
interface Props {
  slug: string;
  class?: string;
  /** px cinsinden kenar uzunluğu */
  size?: number;
}
const { slug, class: cls, size = 44 } = Astro.props;
const arms = [0, 60, 120, 180, 240, 300];
const grains = [34, 26, 18];
---

<svg class={cls} width={size} height={size} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    slug === 'donuk-gida-tasimaciligi' && (
      <>
        {arms.map((a) => (
          <g transform={`rotate(${a} 24 24)`}>
            <line x1="24" y1="24" x2="24" y2="4" />
            <polyline points="19,9 24,14 29,9" />
          </g>
        ))}
        <circle cx="24" cy="24" r="2.5" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    slug === 'soguk-zincir-nakliye' && (
      <>
        <path d="M24 5 C24 5 11 19 11 29 a13 13 0 0 0 26 0 C37 19 24 5 24 5 Z" />
        <path d="M17 30 a7 7 0 0 0 6 6" />
      </>
    )
  }
  {
    slug === 'kuru-gida-nakliye' && (
      <>
        <line x1="24" y1="44" x2="24" y2="14" />
        <ellipse cx="24" cy="9" rx="3" ry="5.5" />
        {grains.map((y) => (
          <>
            <ellipse cx="18" cy={y} rx="3" ry="5.5" transform={`rotate(-38 18 ${y})`} />
            <ellipse cx="30" cy={y} rx="3" ry="5.5" transform={`rotate(38 30 ${y})`} />
          </>
        ))}
      </>
    )
  }
  {
    slug === 'parsiyel-ve-komple-arac' && (
      <>
        <rect x="6" y="36" width="36" height="5" />
        <line x1="11" y1="41" x2="11" y2="44" />
        <line x1="24" y1="41" x2="24" y2="44" />
        <line x1="37" y1="41" x2="37" y2="44" />
        <rect x="7" y="21" width="16" height="15" />
        <rect x="25" y="21" width="16" height="15" />
        <rect x="16" y="6" width="16" height="15" />
        <line x1="15" y1="21" x2="15" y2="26" />
        <line x1="33" y1="21" x2="33" y2="26" />
        <line x1="24" y1="6" x2="24" y2="11" />
      </>
    )
  }
</svg>
