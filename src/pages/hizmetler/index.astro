---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CallButtons from '../../components/CallButtons.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import { services, servicePath } from '../../lib/site';
import { breadcrumbs } from '../../lib/schema';
const crumbs = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Hizmetler', path: '/hizmetler/' },
];
---

<Base
  title="Frigorifik Nakliye Hizmetleri İzmir | ATA Taşımacılık"
  description="Donuk gıda, soğuk zincir ve kuru gıda nakliyesi; parsiyel ve komple araç seçenekleri. İzmir merkezli frigorifik araçlarla gıda taşımacılığı."
  schema={[breadcrumbs(crumbs)]}
>
  <section class="section">
    <div class="wrap prose">
      <Breadcrumbs items={crumbs} />
      <h1>Hizmetlerimiz</h1>
      <p class="intro">
        Yalnızca gıda taşıyoruz. Aracın kasası yükün istediği sıcaklığa ayarlanır. Yükünüz aracı dolduruyorsa komple,
        doldurmuyorsa parsiyel olarak taşırız.
      </p>

      {
        services.map((s) => (
          <article class="svc">
            <ServiceIcon slug={s.slug} class="svc-icon" />
            <div>
              <h2>
                <a href={servicePath(s)}>{s.h1}</a>
              </h2>
              <p>{s.summary}</p>
            </div>
          </article>
        ))
      }
      <CallButtons />
    </div>
  </section>
</Base>

<style>
  .svc {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
    margin-top: 1.1rem;
  }
  .svc-icon {
    width: 2.75rem;
    height: 2.75rem;
    color: var(--navy);
  }
  .svc h2 {
    font-size: 1.35rem;
    margin: 0 0 0.3rem;
  }
  .svc:last-of-type {
    margin-bottom: 2rem;
  }
</style>
